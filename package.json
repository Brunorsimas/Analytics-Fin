{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts",
    "check:build": "tsc -p scripts/tsconfig.json",
    "test": "npm run check:build && node .selfcheck/scripts/selfcheck.js && node .selfcheck/scripts/selfcheck-chat.js && node .selfcheck/scripts/selfcheck-ativos.js && node .selfcheck/scripts/selfcheck-curva.js && node .selfcheck/scripts/smoke.js",
    "e2e": "node scripts/e2e.mjs",
    "migrar": "npm run check:build && node .selfcheck/scripts/migrar.js",
    "sync:tesouro": "npm run check:build && node .selfcheck/scripts/sync-tesouro.js",
    "verify": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.5",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "netlify-cli": "^27.15.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
